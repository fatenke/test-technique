# Copy this file to .env in the same directory and replace the placeholders.
# Never commit .env — it is gitignored.

# MySQL (must match DB_USER / DB_PASS when using the root account)
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=notes

# Spring Boot datasource (injected into the backend container)
DB_USER=root
DB_PASS=change-me

# Grafana (http://localhost:3000)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
